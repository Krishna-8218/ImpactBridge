# Copy this file to .env.local and fill in the real values.
#   cp .env.example .env.local
# .env.local is gitignored. Real values live in the team chat, NEVER in this file.

# --- Database -----------------------------------------------------------------
# Neon Postgres connection string (shared team database).
# Get it from the Neon dashboard → Connection Details → "Pooled connection".
# Must be a postgres:// URL; the app connects via @prisma/adapter-neon.
DATABASE_URL=postgres://user:password@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# --- Better Auth --------------------------------------------------------------
# Signing secret for sessions and tokens. Generate your own:
#   openssl rand -base64 32
# Local dev can use any random value; production uses the one Owner H sets in Vercel.
BETTER_AUTH_SECRET=replace-me-openssl-rand-base64-32

# Base URL of this app. Required — if it is wrong, Google sign-in fails with
# redirect_uri_mismatch. Locally this must be exactly http://localhost:3000
# (everyone runs on port 3000; the Google callback is registered for it).
# In production, set it to the deployed origin, e.g. https://your-app.vercel.app
BETTER_AUTH_URL=http://localhost:3000

# --- Google OAuth -------------------------------------------------------------
# From Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID.
# Authorized redirect URIs must include EVERY origin the team uses:
#   http://localhost:3000/api/auth/callback/google
#   https://<deployed-domain>/api/auth/callback/google
# Leave blank to develop with email/password only; the Google button will not work.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email (optional) ---------------------------------------------------------
# Resend API key. OPTIONAL: leave blank and emails are printed to the server console
# instead of being sent. No feature depends on email, so blank is fine for the hackathon.
RESEND_API_KEY=

# --- Mock / live switch -------------------------------------------------------
# Leave blank for normal behaviour (a route serves mock data until its handler exists).
# Set to 'mock' to force EVERY route to return mock data, even ones with real handlers.
# Per-request overrides: ?__mock=1 or the x-mock: 1 header, and ?__mock=error.
API_MODE=

# Artificial delay in milliseconds added to mock responses, so loading skeletons stay
# honest. 250 is the default. Set to 0 if the delay is getting in your way.
MOCK_DELAY_MS=250
